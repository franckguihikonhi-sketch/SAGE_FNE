<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Les tests verifient la regle de rattachement des lignes, qui vit dans
         le texte des requetes. -->
    <InternalsVisibleTo Include="SageFne.Reader.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- 5.2.x reste compatible avec les SQL Server encore en service chez les
         dossiers Sage 100 (2014, 2016, 2019) ; les versions 6 et 7 durcissent
         le chiffrement et refusent certaines de ces instances. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
  </ItemGroup>

</Project>
